@{
    ViewData["Title"] = "Translation Jobs";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Translation Job Queue</h1>
        <button class="btn btn-primary" id="refreshBtn">
            <i class="bi bi-arrow-clockwise"></i> Refresh
        </button>
    </div>

    <!-- Filter and Action Bar -->
    <div class="card mb-4">
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <label class="form-label fw-bold">Filter by Status</label>
                    <select class="form-select" id="statusFilter">
                        <option value="">All Statuses</option>
                        <option value="NotStarted">Not Started</option>
                        <option value="Running">Running</option>
                        <option value="Succeeded">Succeeded</option>
                        <option value="Failed">Failed</option>
                        <option value="ValidationFailed">Validation Failed</option>
                        <option value="Cancelled">Cancelled</option>
                        <option value="Cancelling">Cancelling</option>
                    </select>
                </div>
                <div class="col-md-6 d-flex align-items-end">
                    <button class="btn btn-danger me-2" id="cancelSelectedBtn" disabled>
                        <i class="bi bi-x-circle"></i> Cancel Selected Jobs
                    </button>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="autoRefresh">
                        <label class="form-check-label" for="autoRefresh">
                            Auto-refresh (every 10s)
                        </label>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Loading Spinner -->
    <div id="loadingSpinner" class="text-center my-5" style="display: none;">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
        <p class="mt-2">Loading translation jobs...</p>
    </div>

    <!-- Error Alert -->
    <div id="errorAlert" class="alert alert-danger" style="display: none;"></div>

    <!-- Jobs Table -->
    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover" id="jobsTable">
                    <thead>
                        <tr>
                            <th style="width: 50px;">
                                <input type="checkbox" id="selectAll" class="form-check-input">
                            </th>
                            <th>Job ID</th>
                            <th>Status</th>
                            <th>Created</th>
                            <th>Last Modified</th>
                            <th>Progress</th>
                            <th>Documents</th>
                            <th>Error</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody id="jobsTableBody">
                        <tr>
                            <td colspan="9" class="text-center text-muted">
                                No jobs found. Click Refresh to load jobs.
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Summary Card -->
    <div class="card mt-4">
        <div class="card-body">
            <h5 class="card-title">Summary</h5>
            <div class="row text-center">
                <div class="col-md-2">
                    <h3 id="totalJobsCount">0</h3>
                    <small class="text-muted">Total Jobs</small>
                </div>
                <div class="col-md-2">
                    <h3 id="runningCount">0</h3>
                    <small class="text-muted">Running</small>
                </div>
                <div class="col-md-2">
                    <h3 id="succeededCount">0</h3>
                    <small class="text-muted">Succeeded</small>
                </div>
                <div class="col-md-2">
                    <h3 id="failedCount">0</h3>
                    <small class="text-muted">Failed</small>
                </div>
                <div class="col-md-2">
                    <h3 id="validationFailedCount">0</h3>
                    <small class="text-muted">Validation Failed</small>
                </div>
                <div class="col-md-2">
                    <h3 id="notStartedCount">0</h3>
                    <small class="text-muted">Not Started</small>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Error Details Modal -->
<div class="modal fade" id="errorDetailsModal" tabindex="-1" aria-labelledby="errorDetailsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="errorDetailsModalLabel">
                    <i class="bi bi-exclamation-triangle-fill"></i> Error Details
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <strong>Job ID:</strong> <code id="errorJobId"></code>
                </div>
                <div class="mb-3">
                    <strong>Status:</strong> <span id="errorStatus" class="badge"></span>
                </div>
                <div class="mb-3">
                    <strong>Error Message:</strong>
                    <pre id="errorMessage" class="mt-2 p-3 bg-light border rounded" style="white-space: pre-wrap; word-wrap: break-word; max-height: 400px; overflow-y: auto;"></pre>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-primary" onclick="copyErrorDetails()">
                    <i class="bi bi-clipboard"></i> Copy Error Details
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let allJobs = [];
        let autoRefreshInterval = null;
        let terminalJobIds = new Set(); // Track jobs that have reached terminal state

        // Load jobs on page load
        document.addEventListener('DOMContentLoaded', function() {
            loadJobs();
        });

        // Refresh button
        document.getElementById('refreshBtn').addEventListener('click', function() {
            // Clear terminal jobs on manual refresh (user wants to see latest)
            terminalJobIds.clear();
            loadJobs();
        });

        // Status filter
        document.getElementById('statusFilter').addEventListener('change', filterJobs);

        // Select all checkbox
        document.getElementById('selectAll').addEventListener('change', function() {
            const checkboxes = document.querySelectorAll('.job-checkbox');
            checkboxes.forEach(cb => cb.checked = this.checked);
            updateCancelButton();
        });

        // Auto-refresh toggle
        document.getElementById('autoRefresh').addEventListener('change', function() {
            if (this.checked) {
                autoRefreshInterval = setInterval(loadJobs, 10000); // Refresh every 10 seconds
            } else {
                if (autoRefreshInterval) {
                    clearInterval(autoRefreshInterval);
                    autoRefreshInterval = null;
                }
            }
        });

        // Cancel selected jobs button
        document.getElementById('cancelSelectedBtn').addEventListener('click', cancelSelectedJobs);

        async function loadJobs() {
            showLoading(true);
            hideError();

            try {
                const response = await fetch('/Translation/GetAllJobs');
                
                if (!response.ok) {
                    throw new Error('Failed to fetch jobs');
                }

                allJobs = await response.json();
                
                // Track jobs that have reached terminal states
                allJobs.forEach(job => {
                    if (isTerminalState(job.status)) {
                        terminalJobIds.add(job.id);
                    }
                });
                
                // Sort by last modified (newest first)
                allJobs.sort((a, b) => new Date(b.lastModified) - new Date(a.lastModified));
                
                filterJobs();
                updateSummary();
                
                // Check if we should stop auto-refresh
                checkAutoRefreshNeeded();
            } catch (error) {
                console.error('Error loading jobs:', error);
                showError('Error loading translation jobs: ' + error.message);
            } finally {
                showLoading(false);
            }
        }

        function isTerminalState(status) {
            // These states won't change - no need to keep checking them
            return status === 'Succeeded' || 
                   status === 'Failed' || 
                   status === 'ValidationFailed' || 
                   status === 'Cancelled';
        }

        function checkAutoRefreshNeeded() {
            // Count jobs that are still in progress (not in terminal state)
            const activeJobs = allJobs.filter(job => !isTerminalState(job.status));
            
            if (autoRefreshInterval) {
                if (activeJobs.length === 0) {
                    console.log('All jobs completed. Auto-refresh will continue but should stop soon.');
                    // Optionally, auto-disable refresh when no active jobs
                    // document.getElementById('autoRefresh').checked = false;
                    // clearInterval(autoRefreshInterval);
                    // autoRefreshInterval = null;
                } else {
                    console.log(`${activeJobs.length} job(s) still in progress. Auto-refresh continues.`);
                }
            }
        }

        function filterJobs() {
            const statusFilter = document.getElementById('statusFilter').value;
            
            let filteredJobs = allJobs;
            if (statusFilter) {
                filteredJobs = allJobs.filter(job => job.status === statusFilter);
            }

            displayJobs(filteredJobs);
        }

        function displayJobs(jobs) {
            const tbody = document.getElementById('jobsTableBody');
            
            if (jobs.length === 0) {
                tbody.innerHTML = `
                    <tr>
                        <td colspan="9" class="text-center text-muted">
                            No jobs found matching the current filter.
                        </td>
                    </tr>
                `;
                return;
            }

            let html = '';
            jobs.forEach((job, index) => {
                const statusBadge = getStatusBadge(job.status);
                const progress = calculateProgress(job);
                const canCancel = canCancelJob(job.status);
                const isTerminal = isTerminalState(job.status);
                const hasError = job.errorMessage && job.errorMessage.length > 0;
                
                // Store job data for error details
                if (hasError) {
                    window[`job_${job.id}`] = job;
                }
                
                html += `
                    <tr ${isTerminal ? 'class="table-secondary"' : ''}>
                        <td>
                            ${canCancel ? `<input type="checkbox" class="form-check-input job-checkbox" data-job-id="${job.id}" onchange="updateCancelButton()">` : ''}
                        </td>
                        <td>
                            <code class="small">${job.id.substring(0, 16)}...</code>
                            <button class="btn btn-sm btn-link" onclick="copyJobId('${job.id}')">
                                <i class="bi bi-clipboard"></i>
                            </button>
                        </td>
                        <td>${statusBadge}</td>
                        <td>${formatDateTime(job.createdOn)}</td>
                        <td>${formatDateTime(job.lastModified)}</td>
                        <td>
                            <div class="progress" style="height: 20px;">
                                <div class="progress-bar ${getProgressBarClass(job.status)}" 
                                     role="progressbar" 
                                     style="width: ${progress}%"
                                     aria-valuenow="${progress}" 
                                     aria-valuemin="0" 
                                     aria-valuemax="100">
                                    ${progress}%
                                </div>
                            </div>
                        </td>
                        <td>
                            <small>
                                <strong>Total:</strong> ${job.totalDocuments}<br>
                                <span class="text-success">? ${job.documentsSucceeded}</span> |
                                <span class="text-danger">? ${job.documentsFailed}</span> |
                                <span class="text-warning">? ${job.documentsInProgress}</span>
                            </small>
                        </td>
                        <td>
                            ${hasError ? `
                                <button class="btn btn-sm btn-outline-danger" 
                                        onclick="showErrorDetails('${job.id}')">
                                    <i class="bi bi-exclamation-triangle"></i> View Details
                                </button>
                            ` : '-'}
                        </td>
                        <td>
                            ${canCancel ? `
                                <button class="btn btn-sm btn-danger" onclick="cancelJob('${job.id}')">
                                    <i class="bi bi-x-circle"></i> Cancel
                                </button>
                            ` : (isTerminal ? '<span class="badge bg-secondary">Final</span>' : '-')}

                            <!-- Hidden job data for error handling -->
                            <div style="display:none;">
                                <span id="job_${job.id}_data">${encodeURIComponent(JSON.stringify(job))}</span>
                            </div>
                        </td>
                    </tr>
                `;
            });

            tbody.innerHTML = html;
        }

        function showErrorDetails(jobId) {
            const job = window[`job_${jobId}`];
            if (!job) {
                console.error('Job not found:', jobId);
                return;
            }
            
            document.getElementById('errorJobId').textContent = job.id;
            document.getElementById('errorStatus').textContent = job.status;
            document.getElementById('errorStatus').className = `badge ${job.status === 'ValidationFailed' ? 'bg-danger' : 'bg-warning'}`;
            document.getElementById('errorMessage').textContent = job.errorMessage || 'No error details available';
            
            const modal = new bootstrap.Modal(document.getElementById('errorDetailsModal'));
            modal.show();
        }

        function copyErrorDetails() {
            const jobId = document.getElementById('errorJobId').textContent;
            const status = document.getElementById('errorStatus').textContent;
            const errorMessage = document.getElementById('errorMessage').textContent;
            
            const details = `Job ID: ${jobId}\nStatus: ${status}\n\nError Details:\n${errorMessage}`;
            
            navigator.clipboard.writeText(details).then(() => {
                showSuccess('Error details copied to clipboard');
            });
        }

        function getStatusBadge(status) {
            const badges = {
                'NotStarted': '<span class="badge bg-secondary">Not Started</span>',
                'Running': '<span class="badge bg-primary">Running</span>',
                'Succeeded': '<span class="badge bg-success">Succeeded</span>',
                'Failed': '<span class="badge bg-danger">Failed</span>',
                'ValidationFailed': '<span class="badge bg-danger"><i class="bi bi-exclamation-triangle"></i> Validation Failed</span>',
                'Cancelled': '<span class="badge bg-warning">Cancelled</span>',
                'Cancelling': '<span class="badge bg-warning">Cancelling</span>'
            };
            return badges[status] || `<span class="badge bg-secondary">${status}</span>`;
        }

        function getProgressBarClass(status) {
            const classes = {
                'Running': 'progress-bar-striped progress-bar-animated',
                'Succeeded': 'bg-success',
                'Failed': 'bg-danger',
                'ValidationFailed': 'bg-danger',
                'Cancelled': 'bg-warning'
            };
            return classes[status] || '';
        }

        function calculateProgress(job) {
            if (job.totalDocuments === 0) return 0;
            const completed = job.documentsSucceeded + job.documentsFailed + job.documentsCanceled;
            return Math.round((completed / job.totalDocuments) * 100);
        }

        function canCancelJob(status) {
            return status === 'NotStarted' || status === 'Running';
        }

        function updateSummary() {
            const statusCounts = {
                running: 0,
                succeeded: 0,
                failed: 0,
                validationFailed: 0,
                cancelled: 0,
                notStarted: 0
            };

            allJobs.forEach(job => {
                switch (job.status) {
                    case 'Running':
                        statusCounts.running++;
                        break;
                    case 'Succeeded':
                        statusCounts.succeeded++;
                        break;
                    case 'Failed':
                        statusCounts.failed++;
                        break;
                    case 'ValidationFailed':
                        statusCounts.validationFailed++;
                        break;
                    case 'Cancelled':
                        statusCounts.cancelled++;
                        break;
                    case 'NotStarted':
                        statusCounts.notStarted++;
                        break;
                }
            });

            document.getElementById('totalJobsCount').textContent = allJobs.length;
            document.getElementById('runningCount').textContent = statusCounts.running;
            document.getElementById('succeededCount').textContent = statusCounts.succeeded;
            document.getElementById('failedCount').textContent = statusCounts.failed;
            document.getElementById('validationFailedCount').textContent = statusCounts.validationFailed;
            document.getElementById('notStartedCount').textContent = statusCounts.notStarted;
        }

        function updateCancelButton() {
            const selectedCheckboxes = document.querySelectorAll('.job-checkbox:checked');
            const cancelBtn = document.getElementById('cancelSelectedBtn');
            cancelBtn.disabled = selectedCheckboxes.length === 0;
        }

        async function cancelJob(jobId) {
            if (!confirm('Are you sure you want to cancel this translation job?')) {
                return;
            }

            try {
                const response = await fetch('/Translation/CancelJob', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ jobId: jobId })
                });

                const result = await response.json();

                if (response.ok) {
                    showSuccess('Job canceled successfully');
                    loadJobs(); // Refresh the list
                } else {
                    showError('Error: ' + result.error);
                }
            } catch (error) {
                console.error('Error canceling job:', error);
                showError('Error canceling job: ' + error.message);
            }
        }

        async function cancelSelectedJobs() {
            const selectedCheckboxes = document.querySelectorAll('.job-checkbox:checked');
            const jobIds = Array.from(selectedCheckboxes).map(cb => cb.dataset.jobId);

            if (jobIds.length === 0) {
                return;
            }

            if (!confirm(`Are you sure you want to cancel ${jobIds.length} translation job(s)?`)) {
                return;
            }

            try {
                const response = await fetch('/Translation/CancelJobs', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ jobIds: jobIds })
                });

                const result = await response.json();

                if (response.ok) {
                    showSuccess(result.message);
                    document.getElementById('selectAll').checked = false;
                    loadJobs(); // Refresh the list
                } else {
                    showError('Error: ' + result.error);
                }
            } catch (error) {
                console.error('Error canceling jobs:', error);
                showError('Error canceling jobs: ' + error.message);
            }
        }

        function copyJobId(jobId) {
            navigator.clipboard.writeText(jobId).then(() => {
                showSuccess('Job ID copied to clipboard');
            });
        }

        function formatDateTime(dateString) {
            const date = new Date(dateString);
            return date.toLocaleString();
        }

        function showLoading(show) {
            document.getElementById('loadingSpinner').style.display = show ? 'block' : 'none';
        }

        function showError(message) {
            const errorAlert = document.getElementById('errorAlert');
            errorAlert.textContent = message;
            errorAlert.style.display = 'block';
        }

        function hideError() {
            document.getElementById('errorAlert').style.display = 'none';
        }

        function showSuccess(message) {
            // Create a toast notification
            const toast = document.createElement('div');
            toast.className = 'toast align-items-center text-white bg-success border-0 position-fixed top-0 end-0 m-3';
            toast.setAttribute('role', 'alert');
            toast.style.zIndex = '9999';
            toast.innerHTML = `
                <div class="d-flex">
                    <div class="toast-body">
                        ${message}
                    </div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
                </div>
            `;
            document.body.appendChild(toast);
            const bsToast = new bootstrap.Toast(toast);
            bsToast.show();
            setTimeout(() => toast.remove(), 3000);
        }

        // Cleanup on page unload
        window.addEventListener('beforeunload', function() {
            if (autoRefreshInterval) {
                clearInterval(autoRefreshInterval);
            }
        });
    </script>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
}

<style>
    .table th {
        background-color: #f8f9fa;
        font-weight: 600;
    }

    .table td {
        vertical-align: middle;
    }

    code {
        background-color: #f8f9fa;
        padding: 2px 6px;
        border-radius: 3px;
    }

    .progress {
        margin: 0;
    }

    .btn-link {
        padding: 0;
        text-decoration: none;
    }

    .toast {
        min-width: 250px;
    }
    
    .table-secondary {
        opacity: 0.7;
    }
</style>
